{
  "id": "power-menu",
  "name": "Power Menu",
  "version": "0.1.0",
  "author": "hbaez \u003chbaez@localhost\u003e",
  "description": "Power Menu is a Ryoku shell plugin.",
  "license": "MIT",
  "official": false,
  "hosts": [
    "topbarGlyph"
  ],
  "entryPoints": {
    "main": "service/Main.qml",
    "content": "content/Widget.qml",
    "panel": "content/Panel.qml"
  },
  "panel": {
    "width": 320
  },
  "files": [],
  "capabilities": {
    "densities": [
      "glyph",
      "compact"
    ]
  },
  "defaults": {
    "host": "topbarGlyph",
    "label": "Power Menu"
  },
  "dependencies": {
    "commands": []
  },
  "metadata": {
    "settings": [
      {
        "key": "showCount",
        "type": "toggle",
        "label": "Show the tick count",
        "group": "Power Menu",
        "default": true
      }
    ]
  }
}
