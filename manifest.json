{
  "id": "power-menu",
  "name": "Power Menu",
  "version": "0.1.0",
  "author": "hbaez <hbaez@localhost>",
  "description": "Log out, lock, suspend, hibernate, reboot and power off from one bar panel.",
  "license": "MIT",
  "official": false,
  "hosts": [
    "topbarGlyph"
  ],
  "entryPoints": {
    "main": "service/Main.qml",
    "content": "content/Widget.qml",
    "panel": "content/Panel.qml"
  },
  "panel": {
    "width": 300
  },
  "files": [
    "bin/hibernate.sh"
  ],
  "capabilities": {
    "densities": [
      "glyph",
      "compact"
    ]
  },
  "defaults": {
    "host": "topbarGlyph",
    "label": "Power Menu"
  },
  "dependencies": {
    "commands": [
      "ryoku-shell",
      "systemctl",
      "hyprctl",
      "journalctl",
      "notify-send"
    ]
  },
  "metadata": {
    "settings": [
      { "key": "confirm", "type": "toggle", "label": "Ask before acting (click twice)", "group": "Behavior", "default": true },
      { "key": "show_logout", "type": "toggle", "label": "Show Log out", "group": "Actions", "default": true },
      { "key": "show_lock", "type": "toggle", "label": "Show Lock", "group": "Actions", "default": true },
      { "key": "show_suspend", "type": "toggle", "label": "Show Suspend", "group": "Actions", "default": true },
      { "key": "show_hibernate", "type": "toggle", "label": "Show Hibernate", "group": "Actions", "default": true },
      { "key": "show_reboot", "type": "toggle", "label": "Show Reboot", "group": "Actions", "default": true },
      { "key": "show_poweroff", "type": "toggle", "label": "Show Power off", "group": "Actions", "default": true }
    ]
  }
}
